# ── OpenRouter / LLM ────────────────────────────────────────────────────────
# Required. Your OpenRouter API key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Chat model used for the neutral cross-outlet AI briefing.
CHAT_MODEL=moonshotai/kimi-k2.6

# ── Embeddings ──────────────────────────────────────────────────────────────
# Embedding model (OpenAI-compatible /embeddings). Used to cluster same-event stories.
EMBEDDING_MODEL=qwen/qwen3-embedding-4b
# Native output dimension of EMBEDDING_MODEL. The LanceDB table is created at this
# width — changing it after the table exists requires rebuilding the vector table.
EMBEDDING_DIM=2560
# Optional: point embeddings at a different OpenAI-compatible provider
# (e.g. DeepInfra / Together / a local vLLM). Defaults to the OpenRouter values above.
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=

# ── News sources ────────────────────────────────────────────────────────────
# Optional. Free key from https://open-platform.theguardian.com/access/.
# If empty, the Guardian outlet is auto-disabled and the RSS outlets still work.
GUARDIAN_API_KEY=

# ── Storage ─────────────────────────────────────────────────────────────────
SQLITE_PATH=./data/fulcrum.db
LANCEDB_PATH=./data/lancedb

# ── Clustering / Blindspot tuning ───────────────────────────────────────────
# Story matching is hybrid: embedding similarity + a title-keyword check.
# Loose cosine-distance band considered for a match (1 - similarity).
CLUSTER_DISTANCE_THRESHOLD=0.40
# Below this distance, merge with no lexical check (embeddings clearly match).
CLUSTER_STRICT_DISTANCE=0.25
# In the loose band, require at least this many shared significant title tokens.
CLUSTER_MIN_TITLE_OVERLAP=2
# Only cluster articles within this rolling time window.
CLUSTER_WINDOW_HOURS=36
# A spectrum side is a "blindspot" if it has fewer than this many distinct outlets...
BLINDSPOT_MIN_SOURCES=2
# ...OR less than this share of total coverage.
BLINDSPOT_MIN_SHARE=0.15

# ── Scheduler / server ──────────────────────────────────────────────────────
REFRESH_INTERVAL_HOURS=3
# Shared secret gating the /admin routes (refresh + outlet management).
# Leave empty to allow admin without a token (DEV ONLY — set this for any real deploy).
ADMIN_TOKEN=
HOST=0.0.0.0
PORT=8000

# ── Fetching ────────────────────────────────────────────────────────────────
USER_AGENT=FulcrumNewsBot/0.1 (+https://github.com/your/fulcrumnews)
FETCH_TIMEOUT_S=30
FETCH_CONCURRENCY=8
LOG_LEVEL=INFO
